# Copia este archivo a .env y ajusta los valores
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/radar

# Opcional: credenciales OAuth2 de OpenSky (https://opensky-network.org -> Account -> API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Grabar posiciones en segundo plano en una zona fija (1 = si)
RECORDER_ENABLED=0
RECORDER_INTERVAL=30
# lamin,lomin,lamax,lomax  (por defecto: Nueva York)
RECORDER_BBOX=40.4774,-74.2591,40.9176,-73.7004

FLASK_DEBUG=1
