# Copia este archivo a .env y ajusta los valores
FLASK_DEBUG=0

# PostgreSQL (opcional: sin esto no hay historial, reproduccion, estadisticas ni alertas)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/radar

# Fuentes de vuelos en orden de preferencia. Si una se agota o falla, se usa la siguiente.
# opensky: la de mejor cobertura en Latinoamerica. Sin cuenta ~400 creditos/dia, con cuenta gratuita ~4000
#   (crear en opensky-network.org > Account > API client y poner las dos claves de abajo).
# adsb.fi: ~1 peticion/s sin tope diario declarado. adsb.lol declara 60 peticiones/min y 500/dia por IP.
PROVIDERS=opensky,adsbfi,adsblol
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Receptor ADS-B propio (readsb/tar1090). Ejemplo: http://192.168.1.50/tar1090/data/aircraft.json
LOCAL_RECEIVER_URL=
RECEIVER_LAT=
RECEIVER_LON=
RECEIVER_RANGE_KM=400

# Grabacion de historial en segundo plano (1 = si). Zonas: lamin,lomin,lamax,lomax;otra zona...
RECORDER_ENABLED=1
RECORDER_INTERVAL=15
RECORD_ZONES=40.4774,-74.2591,40.9176,-73.7004
RETENTION_DAYS=7

# Alertas (opcionales). ADMIN_TOKEN protege crear/borrar elementos de la lista de seguimiento
ADMIN_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Produccion detras de proxy (nginx/Caddy): 1 para confiar en X-Forwarded-*
TRUST_PROXY=0
LOG_JSON=0
